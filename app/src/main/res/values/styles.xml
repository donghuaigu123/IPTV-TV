<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IPTV" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="fontFamily">sans</item>
    </style>

    <style name="Theme.IPTV.Player" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/player_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!--
      ===== 统一按钮体系 =====
      所有 MaterialButton 统一使用以下三种样式，禁止在各布局中单独覆盖
      background / backgroundTint / textColor / cornerRadius / minHeight。
      尺寸基准：标准高度 48dp、圆角 14dp、主/次按钮 14sp 加粗。
    -->

    <!-- 主按钮：品牌渐变填充 + 白字。用于每个页面唯一的主操作 -->
    <style name="BtnPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/grad_btn</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- 次按钮：描边 + 深色填充 + 主文字色。用于并列/次要操作 -->
    <style name="BtnOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/surface_2</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- 文字按钮：无边框无填充 + 品牌亮色文字。用于轻量操作（添加/重置） -->
    <style name="BtnText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/brand_light</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- 统一的圆形图标按钮（播放器/列表内 44dp） -->
    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <!-- 卡片 -->
    <style name="CardSurface" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 标题文字 -->
    <style name="TextSection">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次级说明文字 -->
    <style name="TextCaption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- TV 左侧导航按钮：大尺寸 + 焦点/选中高亮 -->
    <style name="TvNavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:background">@drawable/bg_tv_nav</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/tv_nav_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
