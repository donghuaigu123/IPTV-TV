<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/grad_brand"
            android:contentDescription="@string/import_tvbox"
            android:padding="6dp"
            android:src="@drawable/ic_tvbox"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/tvbox_tips"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/caption_text" />
    </LinearLayout>

    <EditText
        android:id="@+id/etTvBoxUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_edittext"
        android:hint="@string/import_tvbox_hint"
        android:inputType="textUri"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTvBoxUrl"
        style="@style/BtnPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/import_tvbox_from_url" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/divider" />

    <EditText
        android:id="@+id/etTvBoxPaste"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_edittext"
        android:gravity="top"
        android:hint="@string/import_tvbox_paste_hint"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTvBoxPaste"
        style="@style/BtnOutline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/import_tvbox_from_paste" />
</LinearLayout>
